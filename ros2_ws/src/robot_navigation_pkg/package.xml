<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_navigation_pkg</name>
  <version>0.1.0</version>
  <description>
    Point to point navigation for the Tiger Enrichment Ball Robot: heading
    alignment, go to goal controller, waypoint routes and drive calibration.
    Runs on ballrobot_localization_pkg and the teensy_interface_node drive
    interface (firmware v4.7). Python only, no Nav2.
  </description>
  <maintainer email="bn5tfo@pm.me">hjbarry</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>ballrobot_pkg</exec_depend>
  <exec_depend>ballrobot_localization_pkg</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- scripts/calibrate.py -->
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
